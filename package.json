{
	"name": "forthedreamers",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "rm -rf .next && npm i && prisma generate && next dev --turbopack",
		"build": "rm -rf .next && npm i && prisma generate && next build --turbopack",
		"start": "rm -rf .next && npm i && next start -p 3004",
		"lint": "eslint",
		"db:push": "npx prisma db push",
		"db:migrate": "npx prisma migrate dev",
		"db:deploy": "npx prisma migrate deploy",
		"db:studio": "npx prisma studio",
		"db:reset": "prisma migrate reset && prisma migrate dev",
		"auth:generate": "npx @better-auth/cli generate --config ./lib/auth.ts"
	},
	"dependencies": {
		"@prisma/client": "^6.18.0",
		"@prisma/extension-accelerate": "^2.0.2",
		"@radix-ui/react-alert-dialog": "^1.1.15",
		"@radix-ui/react-avatar": "^1.1.10",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.6",
		"@react-email/components": "^0.5.7",
		"@react-email/render": "^1.4.0",
		"better-auth": "^1.3.33",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.23.24",
		"lucide-react": "^0.548.0",
		"next": "^15.5.6",
		"next-themes": "^0.4.6",
		"nodemailer": "^7.0.10",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-qr-code": "^2.0.18",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/nodemailer": "^7.0.3",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.0.0",
		"prisma": "^6.18.0",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5"
	}
}
