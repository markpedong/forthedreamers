generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum PRODUCT_STATUS {
  ACTIVE
  INACTIVE
  DRAFT
}

enum ORDER_STATUS {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PAYMENT_STATUS {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum USER_ROLE {
  ADMIN
  USER
  SELLER
}

// ======================================================
// MODELS
// ======================================================

model User {
  id                 String    @id
  name               String
  email              String    @unique
  email_verified     Boolean   @default(false)
  image              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @default(now()) @updatedAt
  two_factor_enabled Boolean?  @default(false)
  role               USER_ROLE @default(USER)
  banned             Boolean?  @default(false)
  ban_reason         String?
  ban_expires        DateTime?

  sessions   Session[]
  accounts   Account[]
  twofactors TwoFactor[]
  passkeys   Passkey[]

  @@map("users")
}

model Session {
  id              String   @id
  expires_at      DateTime
  token           String   @unique
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  ip_address      String?
  user_agent      String?
  user_id         String
  impersonated_by String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                       String    @id
  account_id               String
  provider_id              String
  user_id                  String
  access_token             String?
  refresh_token            String?
  id_token                 String?
  access_token_expires_at  DateTime?
  refresh_token_expires_at DateTime?
  scope                    String?
  password                 String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("verifications")
}

model TwoFactor {
  id           String @id
  secret       String
  backup_codes String
  user_id      String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("two_factors")
}

model Passkey {
  id            String    @id
  name          String?
  public_key    String
  user_id       String
  credential_id String
  counter       Int
  device_type   String
  backed_up     Boolean
  transports    String?
  created_at    DateTime?
  aaguid        String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("passkeys")
}

model Product {
  id           Int            @id @default(autoincrement())
  name         String
  slug         String         @unique
  brand        String?
  base_price   Float?
  description  String
  images       String[]
  tags         String[]
  review_count Int            @default(0)
  rating       Float          @default(0)
  sold         Int            @default(0)
  stock        Int?
  status       PRODUCT_STATUS @default(ACTIVE)
  seller_id    Int
  category_id  Int
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt

  seller      Seller      @relation(fields: [seller_id], references: [id])
  category    Category    @relation(fields: [category_id], references: [id])
  specs       Spec[]
  variants    Variant[]
  reviews     Review[]
  order_items OrderItem[]

  @@index([seller_id], name: "products_seller_idx")
  @@index([category_id], name: "products_category_idx")
  @@index([name], name: "products_name_idx")
  @@index([brand], name: "products_brand_idx")
  @@index([status], name: "products_status_idx")
  @@index([rating], name: "products_rating_idx")
  @@index([sold], name: "products_sold_idx")
  @@index([base_price], name: "products_base_price_idx")
  @@index([tags], type: Gin, name: "products_tags_gin_idx")
  @@map("products")
}

model Variant {
  id          String   @id
  name        String
  is_required Boolean  @default(true)
  product_id  Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  product Product         @relation(fields: [product_id], references: [id])
  options VariantOption[]

  @@index([product_id, is_required], name: "variants_product_required_idx")
  @@map("variants")
}

model VariantOption {
  id                  String   @id
  variant_option_name String
  price               Float
  discounted_price    Float?
  stock               Int
  coupon              String?
  variant_id          String
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  variant Variant @relation(fields: [variant_id], references: [id])

  reviews     Review[]
  order_items OrderItem[]

  @@unique([variant_id, variant_option_name])
  @@index([variant_id])
  @@index([variant_id, price])
  @@index([variant_id, stock])
  @@map("variant_options")
}

model Spec {
  id         Int      @id @default(autoincrement())
  label      String
  value      String
  product_id Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id])

  @@index([product_id])
  @@map("specs")
}

model Seller {
  id         Int      @id @default(autoincrement())
  store_name String
  contact    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products Product[]
  orders   Order[]

  @@map("sellers")
}

model Category {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Review {
  id                Int      @id @default(autoincrement())
  title             String
  review            String
  rating            Float
  product_id        Int
  variant_option_id String?
  user_id           Int
  created_at        DateTime @default(now())

  product        Product        @relation(fields: [product_id], references: [id])
  variant_option VariantOption? @relation(fields: [variant_option_id], references: [id])

  @@index([product_id])
  @@index([variant_option_id])
  @@index([user_id])
  @@index([rating])
  @@map("reviews")
}

model OrderGroup {
  id             Int            @id @default(autoincrement())
  user_id        Int
  total_amount   Float
  payment_status PAYMENT_STATUS @default(PENDING)
  created_at     DateTime       @default(now())

  orders Order[]

  @@index([user_id, payment_status])
  @@map("order_groups")
}

model Order {
  id               Int          @id @default(autoincrement())
  order_group_id   Int
  seller_id        Int
  subtotal         Float
  shipping_fee     Float        @default(0)
  tax_amount       Float        @default(0)
  total_for_seller Float
  status           ORDER_STATUS @default(PENDING)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  order_group OrderGroup  @relation(fields: [order_group_id], references: [id])
  seller      Seller      @relation(fields: [seller_id], references: [id])
  items       OrderItem[]
  shipments   Shipment[]

  @@index([order_group_id])
  @@index([seller_id])
  @@index([seller_id, status])
  @@index([order_group_id, seller_id])
  @@map("orders")
}

model OrderItem {
  id                           Int      @id @default(autoincrement())
  order_id                     Int
  product_id                   Int
  variant_option_id            String?
  quantity                     Int
  price_at_purchase            Float
  discounted_price_at_purchase Float?
  coupon_used                  String?
  tax_at_purchase              Float?
  final_price_after_discount   Float
  created_at                   DateTime @default(now())

  order          Order          @relation(fields: [order_id], references: [id])
  product        Product        @relation(fields: [product_id], references: [id])
  variant_option VariantOption? @relation(fields: [variant_option_id], references: [id])

  @@index([order_id])
  @@index([product_id])
  @@index([variant_option_id])
  @@index([product_id, order_id])
  @@map("order_items")
}

model Shipment {
  id            Int       @id @default(autoincrement())
  order_id      Int
  carrier       String?
  tracking_code String?
  shipped_at    DateTime?
  delivered_at  DateTime?
  status        String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  order Order @relation(fields: [order_id], references: [id])

  @@index([order_id])
  @@index([tracking_code])
  @@index([status])
  @@map("shipments")
}
