generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum PRODUCT_STATUS {
  ACTIVE
  INACTIVE
  DRAFT
}

enum ORDER_STATUS {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PAYMENT_STATUS {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum USER_ROLE {
  ADMIN
  USER
  SELLER
}

enum ADDRESS_TYPE {
  HOME
  WORK
  OTHER
}

// ======================================================
// MODELS
// ======================================================

model User {
  id               String       @id
  name             String
  email            String
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  twoFactorEnabled Boolean?     @default(false)
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  passkeys         Passkey[]
  addresses        Address[]
  cartItems        Cart[]
  wishlistItems    Wishlist[]
  orderGroups      OrderGroup[]

  role       USER_ROLE @default(USER)
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@map("passkey")
}

// ======================================================
// SELLER & PRODUCT
// ======================================================

model Seller {
  id          Int     @id @default(autoincrement())
  storeName   String
  contact     String?
  rating      Float   @default(0)
  reviewCount Int     @default(0)
  totalSales  Float   @default(0)
  description String?
  address     String?
  logo        String?

  products Product[]
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seller")
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  brand       String?
  basePrice   Float?
  description String
  images      String[]
  tags        String[]
  reviewCount Int            @default(0)
  rating      Float          @default(0)
  sold        Int            @default(0)
  stock       Int?
  status      PRODUCT_STATUS @default(ACTIVE)

  sellerId Int
  seller   Seller @relation(fields: [sellerId], references: [id])

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  specs         Spec[]
  variants      Variant[]
  reviews       Review[]
  orderItems    OrderItem[]
  cartItems     Cart[]
  wishlistItems Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId], map: "product_seller_idx")
  @@index([categoryId], map: "product_category_idx")
  @@index([name], map: "product_name_idx")
  @@index([brand], map: "product_brand_idx")
  @@index([status], map: "product_status_idx")
  @@index([rating], map: "product_rating_idx")
  @@index([sold], map: "product_sold_idx")
  @@index([basePrice], map: "product_baseprice_idx")
  @@index([tags], type: Gin, map: "product_tags_gin_idx")
  @@map("product")
}

model Variant {
  id         String          @id
  name       String
  isRequired Boolean         @default(true)
  productId  Int
  product    Product         @relation(fields: [productId], references: [id])
  options    VariantOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isRequired])
  @@map("variant")
}

model VariantOption {
  id                String  @id
  variantOptionName String
  price             Float
  discountedPrice   Float?
  stock             Int
  coupon            String?

  variantId String
  variant   Variant @relation(fields: [variantId], references: [id])

  reviews    Review[]
  orderItems OrderItem[]
  cartItems  Cart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, variantOptionName])
  @@index([variantId])
  @@index([variantId, price])
  @@index([variantId, stock])
  @@map("variant_option")
}

model Spec {
  id        Int      @id @default(autoincrement())
  label     String
  value     String
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("spec")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("category")
}

// ======================================================
// CART & WISHLIST
// ======================================================

model Cart {
  id              Int            @id @default(autoincrement())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantOptionId String?
  variantOption   VariantOption? @relation(fields: [variantOptionId], references: [id])
  quantity        Int            @default(1)
  addedAt         DateTime       @default(now())

  @@unique([userId, productId, variantOptionId])
  @@index([userId])
  @@map("cart")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist")
}

// ======================================================
// ADDRESS
// ======================================================

model Address {
  id          Int          @id @default(autoincrement())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ADDRESS_TYPE @default(HOME)
  label       String?
  fullName    String
  phoneNumber String
  region      String
  city        String
  postalCode  String
  street      String
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, isDefault])
  @@map("address")
}

// ======================================================
// REVIEWS & ORDERS
// ======================================================

model Review {
  id              Int            @id @default(autoincrement())
  title           String
  review          String
  rating          Float
  productId       Int
  product         Product        @relation(fields: [productId], references: [id])
  variantOptionId String?
  variantOption   VariantOption? @relation(fields: [variantOptionId], references: [id])
  userId          Int
  createdAt       DateTime       @default(now())

  @@index([productId])
  @@index([variantOptionId])
  @@index([userId])
  @@index([rating])
  @@map("review")
}

model OrderGroup {
  id            Int            @id @default(autoincrement())
  userId        String
  totalAmount   Float
  paymentStatus PAYMENT_STATUS @default(PENDING)
  orders        Order[]
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id])

  @@index([userId, paymentStatus])
  @@map("order_group")
}

model Order {
  id             Int          @id @default(autoincrement())
  orderGroupId   Int
  orderGroup     OrderGroup   @relation(fields: [orderGroupId], references: [id])
  sellerId       Int
  seller         Seller       @relation(fields: [sellerId], references: [id])
  subtotal       Float
  shippingFee    Float        @default(0)
  taxAmount      Float        @default(0)
  totalForSeller Float
  status         ORDER_STATUS @default(PENDING)
  items          OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([orderGroupId])
  @@index([sellerId])
  @@index([sellerId, status])
  @@index([orderGroupId, sellerId])
  @@map("order")
}

model OrderItem {
  id                        Int            @id @default(autoincrement())
  orderId                   Int
  order                     Order          @relation(fields: [orderId], references: [id])
  productId                 Int
  product                   Product        @relation(fields: [productId], references: [id])
  variantOptionId           String?
  variantOption             VariantOption? @relation(fields: [variantOptionId], references: [id])
  quantity                  Int
  priceAtPurchase           Float
  discountedPriceAtPurchase Float?
  couponUsed                String?
  taxAtPurchase             Float?
  finalPriceAfterDiscount   Float
  createdAt                 DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantOptionId])
  @@index([productId, orderId])
  @@map("order_item")
}
