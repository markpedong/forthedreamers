generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum USER_ROLE {
  ADMIN
  USER
  SELLER
}

// ======================================================
// MODELS
// ======================================================

model Users {
  id               String      @id
  name             String
  email            String
  emailVerified    Boolean     @default(false)
  image            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @default(now()) @updatedAt
  twoFactorEnabled Boolean?    @default(false)
  sessions         Sessions[]
  accounts         Accounts[]
  twofactors       TwoFactors[]
  passkeys         Passkeys[]

  role       USER_ROLE @default(USER)
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("users")
}

model Sessions {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@map("sessions")
}

model Accounts {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verifications {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verifications")
}

model TwoFactors {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        Users   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactors")
}

model Passkeys {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@map("passkeys")
}

model Products {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  brand       String?
  basePrice   Float?
  description String
  images      String[]
  tags        String[] // ✅ VALID Postgres array type

  reviewCount Int   @default(0)
  rating      Float @default(0)
  sold        Int   @default(0)

  stock Int?

  status ProductStatus @default(ACTIVE)

  sellerId Int
  seller   Sellers @relation(fields: [sellerId], references: [id])

  categoryId Int
  category   Categories @relation(fields: [categoryId], references: [id])

  specs      Specs[]
  variants   Variants[]
  reviews    Reviews[]
  orderItems OrderItems[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ Optimized valid indexes for PostgreSQL
  @@index([sellerId], map: "product_seller_idx")
  @@index([categoryId], map: "product_category_idx")
  @@index([name], map: "product_name_idx")
  @@index([brand], map: "product_brand_idx")
  @@index([status], map: "product_status_idx")
  @@index([rating], map: "product_rating_idx")
  @@index([sold], map: "product_sold_idx")
  @@index([basePrice], map: "product_basePrice_idx")
  // ✅ Valid GIN index (only arrays/json supported)
  @@index([tags], type: Gin, map: "product_tags_gin_idx")

  @@map("products")
}

model Variants {
  id         String  @id
  name       String
  isRequired Boolean @default(true)

  productId Int
  product   Products @relation(fields: [productId], references: [id])

  options VariantOptions[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ Optimized
  @@index([productId, isRequired])

  @@map("variants")
}

model VariantOptions {
  id                String  @id
  variantOptionName String
  price             Float
  discountedPrice   Float?
  stock             Int
  coupon            String?

  variantId String
  variant   Variants @relation(fields: [variantId], references: [id])

  reviews    Reviews[]
  orderItems OrderItems[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ Prevent duplicate option names
  @@unique([variantId, variantOptionName])
  // ✅ Optimized
  @@index([variantId])
  @@index([variantId, price])
  @@index([variantId, stock])

  @@map("variantOptions")
}

model Specs {
  id    Int    @id @default(autoincrement())
  label String
  value String

  productId Int
  product   Products @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])

  @@map("specs")
}

model Sellers {
  id        Int     @id @default(autoincrement())
  storeName String
  contact   String?

  products Products[]
  orders   Orders[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sellers")
}

model Categories {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Products[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Reviews {
  id     Int    @id @default(autoincrement())
  title  String
  review String
  rating Float

  productId Int
  product   Products @relation(fields: [productId], references: [id])

  variantOptionId String?
  variantOption   VariantOptions? @relation(fields: [variantOptionId], references: [id])

  userId    Int
  createdAt DateTime @default(now())

  // ✅ Optimized
  @@index([productId])
  @@index([variantOptionId])
  @@index([userId])
  @@index([rating])

  @@map("reviews")
}

// ======================================================
// ORDER SYSTEM
// ======================================================

model OrderGroups {
  id            Int           @id @default(autoincrement())
  userId        Int
  totalAmount   Float
  paymentStatus PaymentStatus @default(PENDING)

  orders    Orders[]
  createdAt DateTime @default(now())

  // ✅ Optimized
  @@index([userId, paymentStatus])

  @@map("orderGroups")
}

model Orders {
  id           Int        @id @default(autoincrement())
  orderGroupId Int
  orderGroup   OrderGroups @relation(fields: [orderGroupId], references: [id])

  sellerId Int
  seller   Sellers @relation(fields: [sellerId], references: [id])

  subtotal       Float
  shippingFee    Float @default(0)
  taxAmount      Float @default(0)
  totalForSeller Float

  status OrderStatus @default(PENDING)

  items     OrderItems[]
  shipments Shipments[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ Optimized
  @@index([orderGroupId])
  @@index([sellerId])
  @@index([sellerId, status])
  @@index([orderGroupId, sellerId])

  @@map("orders")
}

model OrderItems {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Orders @relation(fields: [orderId], references: [id])

  productId Int
  product   Products @relation(fields: [productId], references: [id])

  variantOptionId String?
  variantOption   VariantOptions? @relation(fields: [variantOptionId], references: [id])

  quantity Int

  priceAtPurchase           Float
  discountedPriceAtPurchase Float?
  couponUsed                String?
  taxAtPurchase             Float?
  finalPriceAfterDiscount   Float

  createdAt DateTime @default(now())

  // ✅ Optimized
  @@index([orderId])
  @@index([productId])
  @@index([variantOptionId])
  @@index([productId, orderId])

  @@map("orderItems")
}

model Shipments {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Orders @relation(fields: [orderId], references: [id])

  carrier      String?
  trackingCode String?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  status       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ Optimized
  @@index([orderId])
  @@index([trackingCode])
  @@index([status])

  @@map("shipments")
}
