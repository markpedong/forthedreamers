generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PRODUCT_STATUS {
  ACTIVE
  INACTIVE
}

enum ORDER_STATUS {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PAYMENT_STATUS {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum USER_ROLE {
  ADMIN
  USER
  SELLER
}

enum ADDRESS_TYPE {
  HOME
  WORK
  OTHER
}

model User {
  id               String       @id
  name             String
  email            String       @unique
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  twoFactorEnabled Boolean      @default(false)
  role             USER_ROLE    @default(USER)
  banned           Boolean      @default(false)
  banReason        String?
  banExpires       DateTime?

  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  passkeys         Passkey[]
  addresses        Address[]
  cartItems        CartItem[]
  wishlistItems    Wishlist[]
  orderGroups      OrderGroup[]
  reviews          Review[]
  seller           Seller?      @relation("UserSeller")
  orders           Order[]

  @@index([createdAt])
  @@index([updatedAt])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([createdAt])
  @@index([updatedAt])
  @@map("session")
}

model Account {
  id                   String    @id
  accountId            String
  providerId           String
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("passkey")
}

model Seller {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation("UserSeller", fields: [userId], references: [id], onDelete: Cascade)
  storeName   String    @unique
  contact     String?
  rating      Float     @default(0)
  reviewCount Int       @default(0)
  totalSales  Float     @default(0)
  description String?
  address     String?
  logo        String?
  banner      String?

  products    Product[]
  orders      Order[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdAt])
  @@map("seller")
}

model Product {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  brand         String?
  basePrice     Float?
  description   String
  images        String[]
  tags          String[]
  reviewCount   Int            @default(0)
  rating        Float          @default(0)
  sold          Int            @default(0)
  stock         Int?
  status        PRODUCT_STATUS @default(INACTIVE)

  sellerId      String
  seller        Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])

  specs         Spec[]
  variants      Variant[]
  reviews       Review[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems Wishlist[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([sellerId], map: "product_seller_idx")
  @@index([categoryId], map: "product_category_idx")
  @@index([name], map: "product_name_idx")
  @@index([brand], map: "product_brand_idx")
  @@index([status], map: "product_status_idx")
  @@index([rating], map: "product_rating_idx")
  @@index([sold], map: "product_sold_idx")
  @@index([basePrice], map: "product_baseprice_idx")
  @@index([tags], type: Gin, map: "product_tags_gin_idx")
  @@index([createdAt])
  @@index([updatedAt])

  @@map("product")
}

model Variant {
  id              String     @id @default(uuid())
  productId       String
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  name            String
  price           Float
  discountedPrice Float?
  coupon          String?
  stock           Int
  image           String?
  attributes      Json

  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([productId])
  @@index([price])
  @@index([discountedPrice])
  @@index([stock])

  @@map("variant")
}

model Spec {
  id        String   @id @default(uuid())
  label     String
  value     String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([createdAt])
  @@index([updatedAt])

  @@map("spec")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  products  Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
  @@index([updatedAt])

  @@map("category")
}

model CartItem {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  quantity  Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, variantId])
  @@index([userId])
  @@index([variantId])
  @@index([productId])

  @@map("cart_item")
}

model Wishlist {
  id        String   @id @default(uuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  addedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([addedAt])

  @@map("wishlist")
}

model Address {
  id          String       @id @default(uuid())

  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        ADDRESS_TYPE @default(HOME)
  label       String?
  fullName    String
  phoneNumber String
  region      String
  city        String
  postalCode  String
  street      String
  isDefault   Boolean      @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, isDefault])
  @@index([createdAt])
  @@index([updatedAt])

  @@map("address")
}

model Review {
  id        String   @id @default(uuid())

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating      Int
  title       String?
  comment     String?
  isPublished Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([variantId])
  @@index([userId])
  @@index([rating])

  @@map("review")
}

model OrderGroup {
  id            String         @id @default(uuid())

  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalAmount   Float
  paymentStatus PAYMENT_STATUS @default(PENDING)

  orders        Order[]

  createdAt     DateTime       @default(now())

  @@index([userId, paymentStatus])
  @@index([createdAt])

  @@map("order_group")
}

model Order {
  id           String      @id @default(cuid())

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  sellerId     String?
  seller       Seller?     @relation(fields: [sellerId], references: [id])

  orderGroupId String?
  orderGroup   OrderGroup? @relation(fields: [orderGroupId], references: [id])

  orderItems   OrderItem[]

  total        Float
  discount     Float?
  coupon       String?
  status       ORDER_STATUS @default(PENDING)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([sellerId])
  @@index([orderGroupId])
  @@index([status])
  @@index([coupon])

  @@map("order")
}

model OrderItem {
  id                        String   @id @default(uuid())

  orderId                   String
  order                     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId                 String
  variant                   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  productId                 String?
  product                   Product? @relation(fields: [productId], references: [id])

  quantity                  Int
  priceAtPurchase           Float
  discountedPriceAtPurchase Float?
  couponUsed                String?
  taxAtPurchase             Float?
  finalPriceAfterDiscount   Float

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
  @@index([couponUsed])

  @@map("order_item")
}