generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id
  name             String
  email            String           @unique
  emailVerified    Boolean          @default(false)
  image            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  twoFactorEnabled Boolean          @default(false)
  role             USER_ROLE        @default(USER)
  banned           Boolean          @default(false)
  banReason        String?
  banExpires       DateTime?
  accounts         Account[]
  addresses        Address?
  cartItems        CartItem[]
  orders           Order[]
  orderGroups      OrderGroup[]
  passkeys         Passkey[]
  returnRequests   ReturnRequest[]
  reviews          Review[]
  seller           Seller?          @relation("UserSeller")
  sessions         Session[]
  supportMessages  SupportMessage[]
  supportTickets   SupportTicket[]
  twofactors       TwoFactor[]
  wishlistItems    Wishlist[]

  @@index([createdAt])
  @@index([updatedAt])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([updatedAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([updatedAt])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("passkey")
}

model Seller {
  id          String    @id @default(uuid())
  userId      String    @unique
  storeName   String    @unique
  contact     String?
  rating      Float     @default(0)
  reviewCount Int       @default(0)
  totalSales  Float     @default(0)
  description String?
  address     String?
  logo        String?
  banner      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orders      Order[]
  products    Product[]
  user        User      @relation("UserSeller", fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("seller")
}

model Product {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  brand           String?
  basePrice       Float?
  description     String
  images          String[]
  tags            String[]
  reviewCount     Int              @default(0)
  rating          Float            @default(0)
  sold            Int              @default(0)
  stock           Int?
  status          PRODUCT_STATUS   @default(INACTIVE)
  sellerId        String
  categoryId      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cartItems       CartItem[]
  orderItems      OrderItem[]
  category        Category         @relation(fields: [categoryId], references: [id])
  seller          Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  returnItems     ReturnItem[]
  returnRequests  ReturnRequest[]
  reviews         Review[]
  specs           Spec[]
  supportMessages SupportMessage[]
  supportTickets  SupportTicket[]
  variants        Variant[]
  wishlistItems   Wishlist[]

  @@index([sellerId], map: "product_seller_idx")
  @@index([categoryId], map: "product_category_idx")
  @@index([name])
  @@index([brand])
  @@index([status])
  @@index([rating])
  @@index([sold])
  @@index([basePrice], map: "product_baseprice_idx")
  @@index([tags], map: "product_tags_gin_idx", type: Gin)
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, createdAt, id], map: "product_status_created_idx")
  @@index([status, categoryId, rating], map: "product_status_category_rating_idx")
  @@index([status, sellerId, createdAt], map: "product_status_seller_created_idx")
  @@map("product")
}

model Variant {
  id              String           @id @default(uuid())
  name            String
  productId       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  attributes      Json
  coupon          String?
  discountedPrice Float?
  image           String?
  price           Float
  stock           Int
  cartItems       CartItem[]
  orderItems      OrderItem[]
  returnItems     ReturnItem[]
  reviews         Review[]
  supportMessages SupportMessage[]
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([price])
  @@index([discountedPrice])
  @@index([stock])
  @@map("variant")
}

model Spec {
  id        String   @id @default(uuid())
  label     String
  value     String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("spec")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([createdAt])
  @@index([updatedAt])
  @@map("category")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  variantId String
  productId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product? @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([userId])
  @@index([variantId])
  @@index([productId])
  @@map("cart_item")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  addedAt   DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([addedAt])
  @@map("wishlist")
}

model Address {
  id          String       @id @default(uuid())
  userId      String       @unique(map: "address_one_default_per_user", where: raw("(\"isDefault\" = true)"))
  type        ADDRESS_TYPE @default(HOME)
  label       String?
  fullName    String
  phoneNumber String
  region      String
  city        String
  postalCode  String
  street      String
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("address")
}

model Review {
  id          String   @id @default(uuid())
  title       String?
  rating      Int
  productId   String
  userId      String
  createdAt   DateTime @default(now())
  comment     String?
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  variantId   String?
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([userId])
  @@index([rating])
  @@map("review")
}

model OrderGroup {
  id            String         @id @default(uuid())
  userId        String
  totalAmount   Float
  paymentStatus PAYMENT_STATUS @default(PENDING)
  createdAt     DateTime       @default(now())
  orders        Order[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, paymentStatus])
  @@index([createdAt])
  @@map("order_group")
}

model Order {
  id              String           @id @default(cuid())
  orderGroupId    String?
  sellerId        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  coupon          String?
  discount        Float?
  total           Float
  shippingFee     Float?
  shippingMethodId String?
  userId          String
  status          ORDER_STATUS     @default(PENDING)
  orderGroup      OrderGroup?      @relation(fields: [orderGroupId], references: [id])
  seller          Seller?          @relation(fields: [sellerId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingMethod  ShippingMethod?  @relation(fields: [shippingMethodId], references: [id])
  orderItems      OrderItem[]
  returnRequests  ReturnRequest[]
  supportMessages SupportMessage[]

  @@index([userId])
  @@index([sellerId])
  @@index([orderGroupId])
  @@index([status])
  @@index([coupon])
  @@index([createdAt, status], map: "order_created_status_idx")
  @@map("order")
}

model OrderItem {
  id                        String   @id @default(uuid())
  orderId                   String
  productId                 String?
  quantity                  Int
  priceAtPurchase           Float
  discountedPriceAtPurchase Float?
  couponUsed                String?
  taxAtPurchase             Float?
  finalPriceAfterDiscount   Float
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  variantId                 String
  order                     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                   Product? @relation(fields: [productId], references: [id])
  variant                   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
  @@index([couponUsed])
  @@map("order_item")
}

model SupportTicket {
  id        String           @id @default(uuid())
  userId    String
  subject   String
  message   String
  category  SUPPORT_CATEGORY @default(OTHER)
  priority  SUPPORT_PRIORITY @default(MEDIUM)
  status    SUPPORT_STATUS   @default(OPEN)
  orderId   String?
  productId String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]
  product   Product?         @relation(fields: [productId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@map("support_ticket")
}

model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  userId    String
  message   String
  isStaff   Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  productId String?
  variantId String?
  orderId   String?
  order     Order?        @relation(fields: [orderId], references: [id])
  product   Product?      @relation(fields: [productId], references: [id])
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   Variant?      @relation(fields: [variantId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@map("support_message")
}

model ReturnRequest {
  id           String        @id @default(uuid())
  orderId      String
  userId       String
  reason       RETURN_REASON
  description  String
  status       RETURN_STATUS @default(PENDING)
  refundAmount Float
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  productId    String?
  items        ReturnItem[]
  order        Order         @relation(fields: [orderId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("return_request")
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnId        String
  variantId       String
  productId       String?
  quantity        Int
  priceAtPurchase Float
  product         Product?      @relation(fields: [productId], references: [id])
  returnRequest   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant         Variant       @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([variantId])
  @@map("return_item")
}

model ShippingMethod {
  id            String  @id @default(uuid())
  name          String
  description   String?
  price         Float
  estimatedDays Int
  isActive      Boolean  @default(true)
  regions       Json?

  orders        Order[]

  @@index([isActive])
  @@index([price])
  @@map("shipping_method")
}

enum PRODUCT_STATUS {
  ACTIVE
  INACTIVE
}

enum ORDER_STATUS {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PAYMENT_STATUS {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum USER_ROLE {
  ADMIN
  USER
  SELLER
}

enum ADDRESS_TYPE {
  HOME
  WORK
  OTHER
}

enum SUPPORT_CATEGORY {
  ORDER
  PRODUCT
  SHIPPING
  ACCOUNT
  OTHER
}

enum SUPPORT_PRIORITY {
  LOW
  MEDIUM
  HIGH
}

enum SUPPORT_STATUS {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum RETURN_REASON {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum RETURN_STATUS {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}
